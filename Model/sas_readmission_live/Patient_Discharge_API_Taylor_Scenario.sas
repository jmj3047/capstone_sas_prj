data work.ui_input(drop=raw feature code) work.ui_long(keep=feature code);
  length raw $32767;
  array features[21]
    DEPARTMENT DIAGNOSIS_ICD_CODE DIAGNOSIS_ICD_GROUP
    DOCTOR GENDER ICD9_TARGET 'Patient location'n RACE_CD
    ADMIT_LOS DISCHARGED_TO va__d_DRG_APR_CODE_NUM
    DRG_APR_SEVERITY DX_CODE ICU_DAYS
    va__d_NUM_CHRONIC_COND_NUM NUM_VISITS OPERATION_COUNT
    ORDER_SET_USED ORDER_TOTAL_CHARGES PATIENT_AGE PROCEDURE_ICD_CODE;
  do feature=1 to 21;
    raw=strip(symget(cats('p',feature)));
    features[feature]=input(raw,?? best32.);
    if missing(features[feature]) or features[feature]<0 then call symputx('bad',1,'L');
    code=features[feature]; output work.ui_long;
  end;
  if ICU_DAYS>ADMIT_LOS or PATIENT_AGE>120 or DRG_APR_SEVERITY not in (0,1,2,3,4)
     or ORDER_SET_USED not in (0,1) then call symputx('bad',1,'L');
  do feature=15,16,17;
    if features[feature] ne int(features[feature]) then call symputx('bad',1,'L');
  end;
  output work.ui_input;
run;
proc sql noprint;
  select count(*) into :invalid trimmed from work.ui_long as a
  where a.feature in (1,3,4,5,7,8,10) and not exists
    (select * from work.ui_allowed as b where a.feature=b.feature and a.code=b.code);
  select count(*) into :diagnosis_matches trimmed
  from work.ui_input as a inner join work.ui_diagnoses as d
  on a.DIAGNOSIS_ICD_CODE=d.icd and a.DIAGNOSIS_ICD_GROUP=d.grp
     and a.ICD9_TARGET=d.target and a.DX_CODE=d.dx;
quit;
%if &bad or &invalid>0 or &diagnosis_matches ne 1 %then %do;
  %fail(Inputs are missing invalid or inconsistent with the original model mapping.);
  %goto cleanup;
%end;

proc casutil sessref=uiwork;
  load casdata='READMISSION_GB.sashdat' incaslib='Models'
    casout='UI_MODEL' outcaslib='CASUSER' replace;
  load data=work.ui_input casout='UI_INPUT' outcaslib='CASUSER' replace;
quit;
%if not %sysfunc(exist(uicas.UI_MODEL)) %then %do;
  %fail(Could not load Models/READMISSION_GB.sashdat. Check the Job log.);
  %goto cleanup;
%end;
proc astore;
  score data=uicas.UI_INPUT rstore=uicas.UI_MODEL out=uicas.UI_OUTPUT;
quit;
%if not %sysfunc(exist(uicas.UI_OUTPUT)) %then %do;
  %fail(The SAS model did not return an output table. Check the Job log.);
  %goto cleanup;
%end;
data work.result;
  set uicas.UI_OUTPUT;
  length request_id $100 model_version $80 warning $256 prediction_status $32;
  request_id=symget('ui_request');
  model_version='READMISSION_GB.sashdat / mappings ab623a470b11f358';
  warning=strip(_WARN_);
  if warning='.' then warning='';
  probability=P_readmitted1;
  if missing(probability) or probability<0 or probability>1 then prediction_status='SCORING_FAILED';
  else if not missing(warning) then prediction_status='SCORED_WITH_WARNING';
  else prediction_status='SCORED';
  scored_at=datetime(); format scored_at e8601dt26.6;
  keep request_id model_version warning probability prediction_status scored_at;
run;
proc json out=_webout nosastags;
  write open object; write values 'ok' true;
  write values 'result';
  write open array;
  export work.result;
  write close;
  write close;
run;
%cleanup:
libname uisrc clear;
libname uicas clear;
cas uiwork terminate;
%mend;
%main;
