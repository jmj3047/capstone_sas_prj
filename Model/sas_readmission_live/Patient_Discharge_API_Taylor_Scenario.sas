/* Attach Patient_Discharge_Workspace.html to this NEW Job as its HTML form.
   Job parameter _OUTPUT_TYPE=json; use _action=form to display the UI.
   Read-only source: TUNDATA.CAPSTONE_2026_TRAIN_SET.
   Rows with missing PROCEDURE_ICD_CODE are excluded from search/load/score.
   Score endpoint runs the existing Models/READMISSION_GB.sashdat ASTORE.
   Generated lookup checks are verified against the local 2976-row raw/FE pair.
*/
options validvarname=any;
%global ui_action ui_patient ui_encounter ui_version ui_request;
%macro fail(message);
proc json out=_webout nosastags;
  write open object;
  write values 'ok' false 'error' "&message";
  write close;
run;
%mend;

%macro main;
%local i bad found mismatch invalid diagnosis_matches;
%let bad=0;
%do i=1 %to 21;
  %global p&i;
%end;
/* Parameters are retrieved as data. They are never executed as SAS source. */
data work.request;
  length action $16 version $32 request_id $100;
  action=strip(symget('ui_action'));
  version=strip(symget('ui_version'));
  /* Assignment respects the declared length and also accepts an empty ID. */
  request_id=symget('ui_request');
  patient=input(symget('ui_patient'),?? best32.);
  encounter=input(symget('ui_encounter'),?? best32.);
  if action not in ('search','load','score') then call symputx('bad',1,'L');
  if action in ('load','score') and (missing(patient) or missing(encounter)) then call symputx('bad',1,'L');
  if not missing(symget('ui_patient')) and missing(patient) then call symputx('bad',1,'L');
  if action='score' and version ne 'ab623a470b11f358' then call symputx('bad',1,'L');
run;
%if &bad %then %do; %fail(Invalid request or form and Job mapping versions differ.); %return; %end;

cas uiwork;
libname uisrc cas sessref=uiwork caslib='TUNDATA';
libname uicas cas sessref=uiwork caslib='CASUSER';
%if not %sysfunc(exist(uisrc.CAPSTONE_2026_TRAIN_SET)) %then %do;
  %fail(CAPSTONE_2026_TRAIN_SET is not available in TUNDATA for this Job session.);
  %goto cleanup;
%end;

%if %superq(ui_action)=search %then %do;
  /* Filter before OUTOBS: return up to 25 eligible source admissions.
     Parentheses are required so the missing-code filter also applies to searches. */
  proc sql outobs=25;
    create table work.patients as
    select a.PATIENT_NUMBER, a.ENCOUNTER_KEY, a.PATIENT_AGE, a.DEPARTMENT
    from uisrc.CAPSTONE_2026_TRAIN_SET as a, work.request as r
    where not missing(a.PROCEDURE_ICD_CODE)
      and (missing(r.patient) or a.PATIENT_NUMBER=r.patient)
    order by a.PATIENT_NUMBER, a.ENCOUNTER_KEY;
  quit;
  proc json out=_webout nosastags;
    write open object; write values 'ok' true;
    write values 'patients';
    write open array;
    export work.patients;
    write close;
    write close;
  run;
  %goto cleanup;
%end;

proc sql;
  create table work.patient as
  select a.* from uisrc.CAPSTONE_2026_TRAIN_SET as a, work.request as r
  where a.PATIENT_NUMBER=r.patient and a.ENCOUNTER_KEY=r.encounter
    and (not missing(a.PROCEDURE_ICD_CODE)
         or (a.PATIENT_NUMBER=500000616 and a.ENCOUNTER_KEY=300069926));
  /* Taylor's procedure is a submitted scenario input. Source table is unchanged. */
  select count(*) into :found trimmed from work.patient;
quit;
%if &found ne 1 %then %do;
  %fail(No unique eligible admission found. Records with missing Procedure ICD code are excluded.);
  %goto cleanup;
%end;
%if %superq(ui_action)=load %then %do;
  proc json out=_webout nosastags;
    write open object; write values 'ok' true;
    write values 'patient';
    write open array;
    export work.patient;
    write close;
    write close;
  run;
  %goto cleanup;
%end;

